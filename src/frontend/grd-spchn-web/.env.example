# Leave blank during local Vite development: /api is proxied to YARP on port 7000.
VITE_API_BASE_URL=

# Screen headings: code (default, e.g. GRD-033-po), title (Purchase Order), or both.
# Screen codes and titles live in src/config/screens.json. Restart Vite after changing.
VITE_SCREEN_LABEL_MODE=code
