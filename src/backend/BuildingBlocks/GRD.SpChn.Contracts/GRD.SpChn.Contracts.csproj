<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>GRD.SpChn.Contracts</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>GRD Supply Chain</Authors>
    <Description>Versioned integration-event contracts shared by GRD Supply Chain services.</Description>
    <PackageTags>contracts;integration-events;microservices</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
