{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "delivery": {
        "ClusterId": "delivery",
        "Match": { "Path": "/api/delivery/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/delivery" } ]
      },
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/inventory" } ]
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/api/notifications/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/notifications" } ]
      },
      "order-management-openapi": {
        "ClusterId": "order-management",
        "Match": { "Path": "/swagger-docs/order-management/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger-docs/order-management" } ]
      },
      "order-management": {
        "ClusterId": "order-management",
        "Match": { "Path": "/orders/{**catch-all}" }
      },
      "organization": {
        "ClusterId": "organization",
        "Match": { "Path": "/api/organization/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/organization" } ]
      },
      "procurement": {
        "ClusterId": "procurement",
        "Match": { "Path": "/api/procurement/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/procurement" } ]
      },
      "product-catalog": {
        "ClusterId": "product-catalog",
        "Match": { "Path": "/api/products/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/products" } ]
      },
      "reporting": {
        "ClusterId": "reporting",
        "Match": { "Path": "/api/reports/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/reports" } ]
      },
      "shipment": {
        "ClusterId": "shipment",
        "Match": { "Path": "/api/shipments/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/shipments" } ]
      },
      "supplier": {
        "ClusterId": "supplier",
        "Match": { "Path": "/api/suppliers/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/suppliers" } ]
      },
      "transportation": {
        "ClusterId": "transportation",
        "Match": { "Path": "/api/transportation/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/transportation" } ]
      },
      "warehouse": {
        "ClusterId": "warehouse",
        "Match": { "Path": "/api/warehouses/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/warehouses" } ]
      }
    },
    "Clusters": {
      "delivery": { "Destinations": { "primary": { "Address": "http://localhost:5294/" } } },
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:7001/" } } },
      "inventory": { "Destinations": { "primary": { "Address": "http://localhost:5018/" } } },
      "notifications": { "Destinations": { "primary": { "Address": "http://localhost:7002/" } } },
      "order-management": { "Destinations": { "primary": { "Address": "http://localhost:5255/" } } },
      "organization": { "Destinations": { "primary": { "Address": "http://localhost:5218/" } } },
      "procurement": { "Destinations": { "primary": { "Address": "http://localhost:5112/" } } },
      "product-catalog": { "Destinations": { "primary": { "Address": "http://localhost:5006/" } } },
      "reporting": { "Destinations": { "primary": { "Address": "http://localhost:5274/" } } },
      "shipment": { "Destinations": { "primary": { "Address": "http://localhost:5059/" } } },
      "supplier": { "Destinations": { "primary": { "Address": "http://localhost:5141/" } } },
      "transportation": { "Destinations": { "primary": { "Address": "http://localhost:5258/" } } },
      "warehouse": { "Destinations": { "primary": { "Address": "http://localhost:5276/" } } }
    }
  }
}
