# Local-development values only. Use a secret manager outside local development.
MYSQL_DATABASE=grd_local
MYSQL_USER=grd
MYSQL_PASSWORD=grd-local
MYSQL_ROOT_PASSWORD=root-local
MYSQL_PORT=3306

RABBITMQ_USER=grd
RABBITMQ_PASSWORD=grd-local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Yopmail is the recipient inbox domain. Configure any real SMTP provider here
# to deliver messages externally; keep SMTP_PASSWORD only in the untracked .env.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=notifications@grd.local
SMTP_FROM_NAME=GRD Supply Chain
